# Normalize all text files to LF in the repository (cross-platform consistency).
# Git stores LF; Windows checkouts get CRLF automatically without warnings.
* text=auto

# Explicitly use LF for source/config files
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.sh    text eol=lf
*.env   text eol=lf
manage.py         text eol=lf
Procfile          text eol=lf
requirements*.txt text eol=lf

# Binary files must never be touched
*.pdf     binary
*.docx    binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.sqlite3 binary
*.pyc     binary
