# ---------------------------------------------------------------------------
# TalentPulse ATS — environment configuration
# Copy this file to .env and adjust as needed.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=UTC

# Production HTTPS notes:
# - Set DJANGO_DEBUG=False
# - Set DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# - Set CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# - Set a strong DJANGO_SECRET_KEY (e.g. python -c "import secrets; print(secrets.token_urlsafe(50))")
# - Enable hardening once HTTPS is live:
#   SECURE_SSL_REDIRECT=True
#   SESSION_COOKIE_SECURE=True
#   CSRF_COOKIE_SECURE=True
#   SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Database
# Dev (default): SQLite file db.sqlite3
# Production:    DB_ENGINE=postgres + the fields below
# ---------------------------------------------------------------------------
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------------------------------------------------------------------------
# Optional LLM deep analysis (hybrid screening)
# The rule-based screening engine works WITHOUT any of this.
# Add an API key to enable AI-powered screening. Any OpenAI-compatible
# endpoint works (OpenAI, Azure, Groq, Together, Ollama, ...).
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
